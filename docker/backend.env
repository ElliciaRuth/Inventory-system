# Backend settings for the local Docker setup. Copied to backend/.env on first run.
# production hides error details and the debug toolbar from the network.
# For local development only, change it to: CI_ENVIRONMENT = development
CI_ENVIRONMENT = production

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

database.default.hostname = db
database.default.database = inventory_system
database.default.username = inventory_user
database.default.password = inventory_pass
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

logger.threshold = 4
