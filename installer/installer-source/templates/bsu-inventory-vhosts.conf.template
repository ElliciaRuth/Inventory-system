# BSU Inventory System on Laragon's Apache, over HTTPS, fully offline.
#
# Generated by manager\configure.ps1 from installer-source\templates\bsu-inventory-vhosts.conf.template
# (adapted from deploy\apache\bsu-inventory.conf.template, the XAMPP setup). Do not edit this copy.
#
# HTTPS is required, not optional: browsers only allow the camera barcode scanner on a
# secure address (window.isSecureContext).

Define BSU_ROOT "{{APP_ROOT}}"
Define BSU_CERTS "{{CERT_DIR}}"

# ── Plain HTTP ───────────────────────────────────────────────────────────────
# Everything is sent to HTTPS. The only file served over plain HTTP is the certificate
# authority other devices install first (it is public; its key never leaves this PC).
<VirtualHost *:{{HTTP_PORT}}>
    ServerName bsu-inventory-http
    UseCanonicalName Off
    DocumentRoot "${BSU_CERTS}/public"

    <Directory "${BSU_CERTS}/public">
        Options None
        AllowOverride None
        Require all denied
        <Files "bsu-inventory-ca.crt">
            Require all granted
            # Phones offer to install a file served with this type
            ForceType application/x-x509-ca-cert
            Header always set Content-Disposition "attachment; filename=bsu-inventory-ca.crt"
        </Files>
    </Directory>

    RewriteEngine On
    RewriteCond %{REQUEST_URI} !=/bsu-inventory-ca.crt
    RewriteRule ^ https://%{SERVER_NAME}{{HTTPS_PORT_SUFFIX}}%{REQUEST_URI} [R=301,L]

    ErrorLog "${BSU_LOGS}/error.log"
    CustomLog "${BSU_LOGS}/access.log" combined
</VirtualHost>

# ── HTTPS: the web app at /, the API at /api ─────────────────────────────────
<VirtualHost *:{{HTTPS_PORT}}>
    # A name the certificate carries; requests by IP address are answered here too
    ServerName localhost
    UseCanonicalName Off
    DocumentRoot "${BSU_ROOT}/frontend/dist"

    SSLEngine on
    SSLCertificateFile "${BSU_CERTS}/server.crt"
    SSLCertificateKeyFile "${BSU_CERTS}/server.key"
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLCipherSuite HIGH:!aNULL:!MD5:!3DES:!RC4:!kRSA
    SSLHonorCipherOrder off

    # The same headers as the Docker/nginx and XAMPP setups
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

    # Speed: HTTP/2 loads the app's many files over one connection; text is sent compressed
    Protocols h2 http/1.1
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml

    # The built Vue app (frontend/dist). Unknown paths are app routes: serve index.html.
    <Directory "${BSU_ROOT}/frontend/dist">
        Options None
        AllowOverride None
        Require all granted
        FallbackResource /index.html
        <Files "index.html">
            Header set Cache-Control "no-store"
        </Files>
    </Directory>
    # Built files carry a content hash in their names, so browsers may keep them for a year
    <Directory "${BSU_ROOT}/frontend/dist/assets">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </Directory>

    # Barcode images written by the backend. Even a tampered SVG can't run scripts.
    Alias /barcodes "${BSU_ROOT}/backend/public/barcodes"
    <Directory "${BSU_ROOT}/backend/public/barcodes">
        Options None
        AllowOverride None
        Require all denied
        <FilesMatch "\.svg$">
            Require all granted
        </FilesMatch>
        Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
    </Directory>

    # The API: every /api URL runs CodeIgniter's front controller, which routes on the
    # full path (api/...). Nothing else in backend/ (.env, app/, vendor/, writable/) is reachable.
    AliasMatch "^/api(?:/.*)?$" "${BSU_ROOT}/backend/public/index.php"
    <Directory "${BSU_ROOT}/backend/public">
        Options None
        AllowOverride None
        Require all denied
        <Files "index.php">
            Require all granted
        </Files>
    </Directory>

    ErrorLog "${BSU_LOGS}/error.log"
    CustomLog "${BSU_LOGS}/access.log" combined
</VirtualHost>
