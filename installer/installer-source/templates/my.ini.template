# BSU Inventory System - MariaDB configuration for the "BSUInventoryDB" Windows service.
# Generated by manager\configure.ps1 from installer-source\templates\my.ini.template.

[mysqld]
datadir={{DATA_DIR}}
port={{PORT}}
# Only this PC can connect. Other computers use the web app, never the database.
bind-address=127.0.0.1
skip-name-resolve
local-infile=0

character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

innodb_buffer_pool_size=256M
innodb_flush_log_at_trx_commit=1
max_allowed_packet=64M
max_connections=100

log-error={{LOG_DIR}}/error.log

[client]
port={{PORT}}
default-character-set=utf8mb4

[mariadb-dump]
max_allowed_packet=64M
