# BSU Inventory System - Apache configuration for the "BSUInventoryWeb" Windows service.
#
# Generated by manager\configure.ps1 from installer-source\templates\httpd.conf.template.
# Do not edit this copy: "Repair" in the Server Manager and every update rewrite it.
#
# Only what the system needs is loaded. Nothing outside frontend\dist, the barcode
# images and backend\public\index.php can be reached (see bsu-inventory-vhosts.conf).

Define SRVROOT "{{APACHE_ROOT}}"
ServerRoot "${SRVROOT}"
Define BSU_LOGS "{{LOG_DIR}}"

{{LISTEN}}

LoadModule access_compat_module modules/mod_access_compat.so
LoadModule alias_module modules/mod_alias.so
LoadModule authz_core_module modules/mod_authz_core.so
LoadModule authz_host_module modules/mod_authz_host.so
LoadModule deflate_module modules/mod_deflate.so
LoadModule dir_module modules/mod_dir.so
LoadModule filter_module modules/mod_filter.so
LoadModule headers_module modules/mod_headers.so
LoadModule http2_module modules/mod_http2.so
LoadModule log_config_module modules/mod_log_config.so
LoadModule mime_module modules/mod_mime.so
LoadModule reqtimeout_module modules/mod_reqtimeout.so
LoadModule rewrite_module modules/mod_rewrite.so
LoadModule setenvif_module modules/mod_setenvif.so
LoadModule socache_shmcb_module modules/mod_socache_shmcb.so
LoadModule ssl_module modules/mod_ssl.so

# PHP from Laragon's bin\php, as an Apache module. The intl extension needs PHP's ICU
# libraries, which are not on Apache's DLL search path: load them first.
{{PHP_LOADFILES}}
LoadModule php_module "{{PHP_DIR}}/php8apache2_4.dll"
PHPIniDir "{{PHP_DIR}}"
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>

ServerName localhost
ServerAdmin admin@localhost
# Don't tell the network which versions run here
ServerTokens Prod
ServerSignature Off
TraceEnable Off

# Enough worker threads for an office LAN; long Excel imports and backups need time
ThreadsPerChild 150
MaxConnectionsPerChild 0
Timeout 300
KeepAlive On
KeepAliveTimeout 5
# Slow or stalled clients can't tie up the server
RequestReadTimeout header=20-40,MinRate=500 body=20,MinRate=500
# Uploads (Excel stock cards, backup packages): PHP's post_max_size is the real limit
LimitRequestBody 104857600

# Deny everything by default; the virtual hosts open exactly what is needed
<Directory />
    AllowOverride None
    Options None
    Require all denied
</Directory>
<Files ".ht*">
    Require all denied
</Files>

DirectoryIndex index.html
TypesConfig conf/mime.types
AddType application/x-x509-ca-cert .crt
AddType image/svg+xml .svg
AddType application/javascript .js .mjs
AddType font/woff2 .woff2

ErrorLog "${BSU_LOGS}/error.log"
LogLevel warn
LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
PidFile "${BSU_LOGS}/httpd.pid"

SSLSessionCache "shmcb:${BSU_LOGS}/ssl_scache(512000)"
SSLSessionCacheTimeout 300
SSLPassPhraseDialog builtin

Include "{{VHOSTS_CONF}}"
